# IMPORTANT: Replace yourdomain.com with your actual domain before deploying.
# Use `just push-caddyfile` to copy the updated file to the VM.
# Caddy automatically provisions and renews Let's Encrypt TLS certificates.
yourdomain.com {
    # Browser API calls hit /api/* — strip the prefix and proxy to the backend.
    # Server-side (SSR) Next.js fetches go directly to kuma-backend:8080 via
    # Docker DNS without touching this route.
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy kuma-backend:8080
    }

    handle {
        reverse_proxy kuma-webapp:3000
    }
}
