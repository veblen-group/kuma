  "query": "\n            SELECT\n                id,\n                token_a_symbol, token_b_symbol,\n                min_price, max_price,\n                min_pool_id, max_pool_id,\n                chain, block_height\n            FROM spot_prices\n            WHERE token_a_symbol = $1 AND token_b_symbol = $2\n            ORDER BY created_at DESC\n            LIMIT $3 OFFSET $4\n            ",
