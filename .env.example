# Copy this file to .env and fill in the values before deploying.
# .env is gitignored — never commit it.

# Cloud SQL Auth Proxy connection name.
# Format: PROJECT_ID:REGION:INSTANCE_NAME
# Find it with: gcloud sql instances describe kuma-db --format="value(connectionName)"
CLOUD_SQL_CONNECTION_NAME=

# Password for the Cloud SQL api_user.
# Set when creating the user: gcloud sql users create api_user --instance=kuma-db --password=...
PGPASSWORD=
